rules_version = '2';

// Règles de sécurité de la base Firestore de Collection (projet mes-livres-dafce).
// Ce fichier est une référence : les règles actives se règlent dans la console Firebase
// (Firestore Database > Règles). Chaque compte ne peut lire et modifier que son propre document.
service cloud.firestore {
  match /databases/{database}/documents {

    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Wishlists partagées par lien : lisibles par qui a le lien (get, pas de liste de
    // tous les partages), modifiables par leur propriétaire, au format écrit par share.js
    match /shares/{shareId} {
      function validShare(d) {
        return d.keys().hasOnly(['owner', 'name', 'items', 'config', 'updatedAt'])
          && d.owner == request.auth.uid
          && d.name is string && d.name.size() <= 200
          && d.items is list && d.items.size() <= 2000
          && d.config is map
          && d.config.keys().hasOnly(['cats', 'types', 'notes', 'avis'])
          && d.config.cats is list
          && d.config.cats.hasOnly(['lu', 'en-cours', 'a-lire', 'abandonne', 'wishlist'])
          && d.config.types is list
          && d.config.types.hasOnly(['livre', 'film', 'serie', 'jeu'])
          && d.config.notes is bool && d.config.avis is bool;
      }
      allow get: if true;
      allow create: if request.auth != null && validShare(request.resource.data);
      allow update: if request.auth != null && resource.data.owner == request.auth.uid
                    && validShare(request.resource.data);
      allow delete: if request.auth != null && resource.data.owner == request.auth.uid;
    }

    // Statistiques d'utilisation : chaque compte écrit les siennes ; seule l'administratrice
    // (son identifiant remplace ADMIN_UID, cf. admin.html) peut toutes les lire
    match /usage/{userId} {
      allow read: if request.auth != null
                  && (request.auth.uid == userId || request.auth.uid == 'ADMIN_UID');
      allow create, update: if request.auth != null && request.auth.uid == userId;
    }

    // recoUsage/{userId} (demandes de recommandations par jour) : écrit seulement par la
    // fonction serveur (functions/index.js), qui n'est pas soumise à ces règles. Aucun accès depuis l'appli.

    // Tout le reste est interdit
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
