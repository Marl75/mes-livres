rules_version = '2';

// Règles de sécurité de la base Firestore de Collection (projet mes-livres-dafce).
// Ce fichier est une référence : les règles actives se règlent dans la console Firebase
// (Firestore Database > Règles). Chaque compte ne peut lire et modifier que son propre document.
service cloud.firestore {
  match /databases/{database}/documents {

    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Wishlists partagées par lien : lisibles par qui a le lien (get, pas de liste de
    // tous les partages), modifiables par leur propriétaire, au format écrit par share.js
    match /shares/{shareId} {
      function validShare(d) {
        return d.keys().hasOnly(['owner', 'name', 'items', 'config', 'updatedAt'])
          && d.owner == request.auth.uid
          && d.name is string && d.name.size() <= 200
          && d.items is list && d.items.size() <= 2000
          && d.config is map
          && d.config.keys().hasOnly(['cats', 'types', 'notes', 'avis'])
          && d.config.cats is list
          && d.config.cats.hasOnly(['lu', 'en-cours', 'a-lire', 'abandonne', 'wishlist'])
          && d.config.types is list
          && d.config.types.hasOnly(['livre', 'film', 'serie', 'jeu'])
          && d.config.notes is bool && d.config.avis is bool;
      }
      allow get: if true;
      allow create: if request.auth != null && validShare(request.resource.data);
      allow update: if request.auth != null && resource.data.owner == request.auth.uid
                    && validShare(request.resource.data);
      allow delete: if request.auth != null && resource.data.owner == request.auth.uid;
    }

    // Statistiques d'utilisation : chaque compte écrit les siennes ; seule l'administratrice
    // (son identifiant remplace ADMIN_UID, cf. marl75.github.io/admin) peut toutes les lire.
    // Les écritures sont limitées à ce que fait usage.js : les compteurs du mois en cours
    // avancent d'au plus 1 à la fois, les mois passés et les chiffres des recommandations
    // (écrits par la fonction serveur) ne peuvent pas être modifiés, l'e-mail est celui du compte.
    match /usage/{userId} {
      // Mois au format AAAA-MM, comme monthKey() dans usage.js
      function ym(t) {
        return string(t.year()) + '-' + (t.month() < 10 ? '0' : '') + string(t.month());
      }
      function step(after, before, f) {
        return after.get(f, 0) is int
            && (after.get(f, 0) == before.get(f, 0) || after.get(f, 0) == before.get(f, 0) + 1);
      }
      function validMonth(after, before) {
        return after.diff(before).affectedKeys()
                 .hasOnly(['sessions', 'modified', 'deleted', 'recoAdded', 'recoDismissed',
                           'typesChosen', 'typesSkipped', 'lastSeen'])
            && step(after, before, 'sessions') && step(after, before, 'modified')
            && step(after, before, 'deleted') && step(after, before, 'recoAdded')
            && step(after, before, 'recoDismissed') && step(after, before, 'typesChosen')
            && step(after, before, 'typesSkipped');
      }
      function validUsage(after, before) {
        let changed = after.diff(before).affectedKeys();
        let months = after.get('months', {});
        let old = before.get('months', {});
        // Mois en cours : celui de l'appareil peut différer du mois UTC près d'un changement de mois
        let m1 = ym(request.time - duration.value(14, 'h'));
        let m2 = ym(request.time + duration.value(14, 'h'));
        let changedMonths = months.diff(old).affectedKeys();
        return changed.hasOnly(['email', 'firstSeen', 'lastSeen', 'createdByMonth', 'itemCount',
                                'profileCount', 'docBytes', 'types', 'typesCustom', 'months'])
            && (!('email' in changed) || after.email == request.auth.token.get('email', ''))
            && (!('firstSeen' in changed) || !('firstSeen' in before))
            && changedMonths.hasOnly([m1, m2]) && changedMonths.size() <= 1
            && validMonth(months.get(m1, {}), old.get(m1, {}))
            && validMonth(months.get(m2, {}), old.get(m2, {}));
      }
      allow read: if request.auth != null
                  && (request.auth.uid == userId || request.auth.uid == 'ADMIN_UID');
      allow create: if request.auth != null && request.auth.uid == userId
                    && validUsage(request.resource.data, {});
      allow update: if request.auth != null && request.auth.uid == userId
                    && validUsage(request.resource.data, resource.data);
    }

    // Recommandations par jour (recoDaily/{AAAA-MM-JJ}) : compteur global et détail par compte,
    // écrit par la fonction serveur ; lisible seulement par l'administratrice
    match /recoDaily/{day} {
      allow read: if request.auth != null && request.auth.uid == 'ADMIN_UID';
    }

    // recoUsage/{userId} (demandes de recommandations par jour) : écrit seulement par la
    // fonction serveur (functions/index.js), qui n'est pas soumise à ces règles. Aucun accès depuis l'appli.

    // Tout le reste est interdit
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
